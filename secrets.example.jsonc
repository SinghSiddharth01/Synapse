{
  // Cirrascale / Qualcomm Cloud AI 100 — synthesis and (with --live) retrieval.
  // `api_key` and `base_url` are read by scripts/local_model_server.py:_credentials
  // and scripts/rehearse_demo.py:_inference_cloud_key, which agree on precedence.
  // `model` is documentation, not configuration: nothing reads it. The model
  // actually used is chosen on the command line
  // (--distiller-model / --synthesizer-model, scripts/serve_local.py), and this
  // line records which one the team has credit for.
  // Leave blank to run on the fixture stand-in; nothing here is required for a
  // first run of scripts/serve_local.py.
  "inference_cloud": {
    "api_key": "",
    "base_url": "",
    "model": "Llama-3.3-70B"
  },

  // Optional — only for `--distiller anthropic`. Read by
  // scripts/serve_local.py:_anthropic_key. `--distiller claude-cli` needs
  // NO key at all: it uses your local `claude` binary's subscription.
  "anthropic": {
    "api_key": ""
  }
}
