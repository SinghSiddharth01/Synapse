# Internal hackathon materials — contain credentials, do not publish
docs/misc/

# API credentials — secrets.jsonc is the canonical team credentials file,
# distributed offline only. secrets.example.jsonc (committed) is the template.
secrets.jsonc
api-1.json
.env

.DS_Store

# Python / uv
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.coverage

# Worker runtime state: follow offsets, the pending-turn buffer, and the
# write-ahead log. Machine-local and per-session — committing it would push one
# developer's transcript position onto everyone else's checkout.
.synapse/

# Recall-harness output. Cross-task baselines (Task 7 → Task 12) live here
# rather than in /tmp, which does not survive a reboot between Aug 5 and Aug 6.
.measurements/

# Local end-to-end walkthrough runtime state (scripts/demo_local.py):
# scratch transcripts, per-worker WAL, process logs. Machine-local.
.demo/

# Playwright MCP scratch output (screenshots, snapshots)
.playwright-mcp/

# MCP readiness probe scratch state
.mcpprobe/

# mkdocs build output. `mkdocs build` writes 119 files here, and a stray
# `git add -A` after a docs build would commit a whole rendered copy of the
# site alongside its source. GitHub Pages builds from docs/, never from this.
site/
